# ── Client-side (embedded in app bundle — safe to expose) ──────────
# Get these from your Supabase project: Settings > API
# REQUIRED: a release build without them shows an "App not set up" screen (demo mode is only for development).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public read URL for your R2 bucket (via custom domain or r2.dev subdomain).
# REQUIRED: R2 is the only photo storage. Without it every upload fails with "Photo storage is not set up".
EXPO_PUBLIC_R2_PUBLIC_URL=https://storage.yourdomain.com

# Where the web app is hosted. Quote approval links point here
# (…/approve/<token>); leave empty to share PDFs only.
EXPO_PUBLIC_WEB_URL=https://app.yourdomain.com

# ── Server-side ONLY (Supabase Edge Function secrets) ──────────────
# These must NEVER be prefixed with EXPO_PUBLIC_
# Set via: supabase secrets set KEY=VALUE
#
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=your-bucket-name
# R2_PUBLIC_URL=https://storage.yourdomain.com
# REQUIRED for worker ID photos: a SECOND R2 bucket with NO public address. Without it the media
# function refuses ID photo uploads (they never go to the public bucket).
# R2_PRIVATE_BUCKET_NAME=your-private-bucket-name
#
# Email when a customer approves/declines (send-notification function):
# RESEND_API_KEY=re_...
# NOTIFY_EMAIL_FROM=Your Company <noreply@yourcompany.com>
#
# This app's settings for the server functions. They CANNOT read src/config/brand.js, so give them the SAME values as that file
# (each one is optional: without it a function uses the starter kit's placeholder):
# APP_WEB_URL=https://app.yourdomain.com        # app.webUrl  (quote links in emails, weather User-Agent)
# APP_NAME=Starter App                          # app.name    (names the app to the weather / map services)
# COMPANY_NAME=Your Company                     # company.name (email sender name and fallback company name)
# SUPPORT_EMAIL=support@yourcompany.com         # company.supportEmail (reply address when the company has no email set)
# COMPANY_TIMEZONE=America/New_York             # company.timezone (times written in emails)
# BRAND_COLOR=#2B2B2B                           # look.brandColor (email buttons and links)
# WEATHER_ENABLED=true                          # set to false when features.weather is off (the weather function then serves nobody)
# NWS_CONTACT=you@yourdomain.com                # optional contact the weather function gives the National Weather Service

# Address suggestions while typing (Google Cloud > APIs > "Places API (New)"). Restrict the key to that API and to the app's
# bundle id (src/config/brand.js app.bundleId). Leave empty to keep plain typing.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=
